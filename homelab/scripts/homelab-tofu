#!/usr/bin/env bash
set -euo pipefail

operation="${HOMELAB_TOFU_OPERATION:-}"
case "${operation}" in
  plan|apply|import)
    ;;
  *)
    printf '%s\n' "HOMELAB_TOFU_OPERATION must be plan, apply, or import" >&2
    exit 64
    ;;
esac

if [[ $# -gt 0 && "${1}" == "--help" ]]; then
  if [[ "${operation}" == "import" ]]; then
    cat <<'EOF'
Usage: homelab import <OUTPUT ADDRESS> <RESOURCE ID>

Imports an existing object into the OpenTofu state so it is not recreated,
for example:

  homelab import 'dsm_container_project.radarr' radarr
EOF
    exit 0
  elif [[ "${operation}" == "plan" ]]; then
    cat <<'EOF'
Usage: homelab plan [OpenTofu plan options]

Runs a read-only OpenTofu plan for the UniFi reservations/local DNS records,
the Cloudflare public DNS record, and the Synology DSM tasks and container
project declared by the Nix homelab inventory.

Exit status 0 means no drift, 2 means OpenTofu found proposed changes, and
any other nonzero status is an error.
EOF
  else
    cat <<'EOF'
Usage: homelab apply [OpenTofu apply options]

Generates a fresh OpenTofu plan and asks for confirmation before changing the
UniFi, Cloudflare, and Synology DSM resources declared by the Nix homelab
inventory.

Pass -auto-approve only when an unattended apply is intentional.
EOF
  fi
  exit 0
fi

: "${HOMELAB_MANIFEST_FILE:?HOMELAB_MANIFEST_FILE must point to the Nix manifest}"
: "${HOMELAB_TOFU_MODULE:?HOMELAB_TOFU_MODULE must point to the OpenTofu module}"
: "${UNIFI_API_KEY_FILE:?UNIFI_API_KEY_FILE must point to the agenix secret}"
: "${CLOUDFLARE_ENV_FILE:?CLOUDFLARE_ENV_FILE must point to the agenix environment file}"
: "${SYNOLOGY_ENV_FILE:?SYNOLOGY_ENV_FILE must point to the agenix environment file}"

umask 077
state_dir="${HOMELAB_TOFU_STATE_DIR:-${XDG_STATE_HOME:-${HOME}/.local/state}/homelab-tofu}"
mkdir -p "${state_dir}"

manifest_json="$(<"${HOMELAB_MANIFEST_FILE}")"
export TF_VAR_manifest_json="${manifest_json}"
unifi_api_key="$(<"${UNIFI_API_KEY_FILE}")"
export UNIFI_API_KEY="${unifi_api_key}"

# The existing agenix file is an EnvironmentFile used by Caddy.
# shellcheck disable=SC1090
source "${CLOUDFLARE_ENV_FILE}"
export CLOUDFLARE_API_TOKEN="${CLOUDFLARE_API_TOKEN:-${CF_API_TOKEN:-}}"
: "${CLOUDFLARE_API_TOKEN:?CF_API_TOKEN must be present in the Cloudflare agenix file}"

# DSM credentials for the batonogov/synology-dsm provider. Export the whole
# EnvironmentFile (SYNOLOGY_DSM_USERNAME, SYNOLOGY_DSM_PASSWORD). The host is
# derived from the inventory manifest, not the secret.
set -a
# shellcheck disable=SC1090
source "${SYNOLOGY_ENV_FILE}"
set +a
: "${SYNOLOGY_DSM_USERNAME:?SYNOLOGY_DSM_USERNAME must be present in the Synology agenix file}"
: "${SYNOLOGY_DSM_PASSWORD:?SYNOLOGY_DSM_PASSWORD must be present in the Synology agenix file}"

# The provider schema marks these required, so feed them through variables.
export TF_VAR_dsm_username="${SYNOLOGY_DSM_USERNAME}"
export TF_VAR_dsm_password="${SYNOLOGY_DSM_PASSWORD}"

export TF_DATA_DIR="${state_dir}/tofu-data"

tofu -chdir="${HOMELAB_TOFU_MODULE}" init \
  -input=false \
  -lockfile=readonly \
  -upgrade=false \
  -reconfigure

if [[ "${operation}" == "import" ]]; then
  tofu -chdir="${HOMELAB_TOFU_MODULE}" import \
    -input=false \
    -state="${state_dir}/terraform.tfstate" \
    "$@"
elif [[ "${operation}" == "plan" ]]; then
  tofu -chdir="${HOMELAB_TOFU_MODULE}" plan \
    -input=false \
    -detailed-exitcode \
    -state="${state_dir}/terraform.tfstate" \
    "$@"
else
  # Without -auto-approve, OpenTofu creates a fresh plan and asks for an
  # explicit confirmation. Do not add -input=false here: that would disable
  # the confirmation prompt and make a normal apply fail closed.
  tofu -chdir="${HOMELAB_TOFU_MODULE}" apply \
    -state="${state_dir}/terraform.tfstate" \
    "$@"
fi
