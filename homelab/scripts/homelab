#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: homelab <command> [args]

OpenTofu for the homelab inventory (UniFi reservations + DNS, Cloudflare DNS,
and the Synology DSM tasks + container projects).

Commands:
  plan                Show pending changes (read-only)
  apply               Apply changes (asks for confirmation)
  import <addr> <id>  Adopt an existing object into OpenTofu state
  bump [--dry-run]    Update pinned image tags in compose/*.yaml
  manifest            Print the generated homelab manifest JSON
  help                Show this help

Run from the repo checkout (or set HOMELAB_REPO) so plan/apply/bump read the
live tree; otherwise the packaged /nix/store snapshot from the last switch is
used.

Examples:
  homelab plan
  homelab apply
  homelab import 'dsm_container_project.radarr' radarr
  homelab bump --dry-run
EOF
}

# The packaged HOMELAB_TOFU_MODULE/HOMELAB_COMPOSE_DIR point into the read-only
# /nix/store snapshot taken at switch time. When run from a checkout (or with
# HOMELAB_REPO set), prefer the live tree so .tf/compose edits and `bump`
# rewrites take effect without a re-switch.
resolve_repo() {
  if [ -n "${HOMELAB_REPO:-}" ] && [ -d "${HOMELAB_REPO}/homelab/opentofu" ]; then
    printf '%s' "${HOMELAB_REPO}"
    return 0
  fi
  local search="${PWD}"
  while [ "${search}" != "/" ]; do
    if [ -d "${search}/homelab/opentofu" ]; then
      printf '%s' "${search}"
      return 0
    fi
    search="$(dirname "${search}")"
  done
  return 1
}

if repo="$(resolve_repo)"; then
  export HOMELAB_REPO="${repo}"
  export HOMELAB_TOFU_MODULE="${repo}/homelab/opentofu"
  export HOMELAB_COMPOSE_DIR="${repo}/homelab/opentofu/compose"
fi

command="${1:-help}"
if [ "$#" -gt 0 ]; then
  shift
fi

case "${command}" in
  plan | apply | import)
    export HOMELAB_TOFU_OPERATION="${command}"
    exec bash "${HOMELAB_TOFU_LAUNCHER}" "$@"
    ;;
  bump)
    exec python3 "${HOMELAB_BUMP_SCRIPT}" "$@"
    ;;
  manifest)
    exec cat "${HOMELAB_MANIFEST_FILE}"
    ;;
  help | --help | -h)
    usage
    ;;
  *)
    printf 'homelab: unknown command: %s\n\n' "${command}" >&2
    usage >&2
    exit 64
    ;;
esac
